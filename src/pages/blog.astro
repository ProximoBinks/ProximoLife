---
import Layout from "../components/Layout.astro";
import Window from "../components/Window.astro";
import PostList from "../components/PostList.astro";
import { api, database } from "../utils/database";
import type { FunctionReturnType } from "convex/server";
let result: FunctionReturnType<typeof api.posts.list> = { posts: [], next: null };
let unavailable = false;
try { const { client, secret } = database(); result = await client.query(api.posts.list, { secret, paginationOpts: { numItems: 30, cursor: Astro.url.searchParams.get("before") } }); }
catch { unavailable = true; Astro.response.status = 503; }
const tags = [...new Set(result.posts.flatMap(p => p.tags))].sort();
const publicCount = result.posts.filter(p => p.isPublic).length;
---
<Layout title="proximo – digital diary" description="Notes on what I’m building, what’s been happening, and what I’m still figuring out.">
  <Window title="Digital Diary" heading proxy="/aqua/icons/documentsfolder.png" class="opens" bodyClass="flush">
    <div class="toolbar small" slot="toolbar">
      <a class="toolbar-item" href="/"><img src="/aqua/icons/finder.png" alt="" width="16" height="16" /><span>Home</span></a>
      <a class="toolbar-item" href="/rss.xml"><img src="/aqua/icons/networkglobe.png" alt="" width="16" height="16" /><span>Subscribe</span></a>
      <i class="spacer"></i>
      {!unavailable && result.posts.length > 0 && <>
        <span class="tool-field"><label for="tag-filter">Tag</label><span class="select-wrapper"><select id="tag-filter"><option value="">All</option>{tags.map(tag => <option value={tag}>{tag}</option>)}</select></span></span>
        <span class="tool-field"><label for="search" class="sr-only">Search entries</label><input id="search" type="search" placeholder="Search" autocomplete="off" /></span>
      </>}
    </div>
    {unavailable ? <div class="list-empty" role="status"><h2>The diary couldn’t be loaded.</h2><p>Try loading the page again in a moment. <a href="/blog">Try again</a></p></div>
      : result.posts.length === 0 ? <div class="list-empty"><h2>No entries here yet.</h2><p>There are no posts on this page.</p></div>
      : <PostList posts={result.posts} filterable />}
    <Fragment slot="status">
      <span id="filter-status" role="status">{result.posts.length} items, {publicCount} public</span>
      <span class="spacer"></span>
      {Astro.url.searchParams.has("before") && <a href="/blog">Latest entries</a>}
      {result.next && <a href={`/blog?before=${encodeURIComponent(result.next)}`}>Older entries</a>}
    </Fragment>
  </Window>
</Layout>
<script>
  const tag = document.querySelector<HTMLSelectElement>("#tag-filter");
  const search = document.querySelector<HTMLInputElement>("#search");
  const status = document.getElementById("filter-status");
  const initial = status?.textContent ?? "";
  const filter = () => {
    const term = search?.value.trim().toLowerCase() ?? "";
    let shown = 0;
    document.querySelectorAll<HTMLElement>("tr[data-tags]").forEach(row => {
      const tags: string[] = JSON.parse(row.dataset.tags ?? "[]");
      row.hidden = (!!tag?.value && !tags.includes(tag.value)) || (!!term && !row.dataset.title?.includes(term));
      if (!row.hidden) shown++;
    });
    if (status) status.textContent = !tag?.value && !term ? initial : shown ? `${shown} ${shown === 1 ? "item" : "items"} match` : "No entries match";
  };
  tag?.addEventListener("change", filter);
  search?.addEventListener("input", filter);
</script>
