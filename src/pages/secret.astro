---
import Layout from "../components/Layout.astro";
import Window from "../components/Window.astro";
const icons = [
  { label: "Team", icon: "genericfolder", x: "24px", y: "10px", open: "team-window" },
  { label: "Blog", icon: "sitesfolder", x: "24px", y: "120px", href: "/blog" },
  { label: "Stickies", icon: "stickies", x: "24px", y: "230px", href: "/" },
  { label: "Trash", icon: "trashempty", x: "24px", y: "calc(100% - 110px)", open: "trash-window" },
];
---
<Layout title="proximo – the archive" noindex>
  <h1 class="sr-only">The Archive</h1>
  <div class="desktop-area" data-desktop>
    {icons.map(icon => (
      <button type="button" class="desk-icon" style={`left: ${icon.x}; top: ${icon.y}`} data-open={icon.open} data-href={icon.href}>
        <img src={`/aqua/icons/${icon.icon}.png`} alt="" width="56" height="56" draggable="false" />
        <span>{icon.label}</span>
      </button>
    ))}
    <Window id="team-window" title="Team" proxy="/aqua/icons/genericfolder.png" status="4 items" bodyClass="flush" closable hidden>
      <ul class="icon-view">
        {["chlo.jpg", "fuz.jpg", "joe.jpg", "v.jpeg"].map(name => <li><img src="/aqua/icons/jpeg.png" alt="" width="48" height="48" />{name}</li>)}
      </ul>
    </Window>
    <Window id="trash-window" title="Trash" proxy="/aqua/icons/trashempty.png" status="0 items" bodyClass="flush" closable hidden>
      <p class="empty-trash">The Trash is empty.</p>
    </Window>
  </div>
  <p class="desk-hint"><span class="on-desktop">Double-click to open · drag things around</span><span class="on-touch">Tap to open</span></p>
</Layout>
<script>
  const desktop = document.querySelector<HTMLElement>("[data-desktop]")!;
  const DRAG_THRESHOLD = 3;
  let highestZIndex = 10;
  const raise = (el: HTMLElement) => { el.style.zIndex = String(++highestZIndex); };
  const canDrag = () => matchMedia("(min-width: 641px)").matches;

  // Returns a function that reports whether the last press turned into a drag.
  function makeDraggable(target: HTMLElement, handle: HTMLElement = target) {
    let offsetX = 0, offsetY = 0, startX = 0, startY = 0, dragging = false;
    handle.addEventListener("pointerdown", e => {
      if ((e.target as HTMLElement).closest("[data-close]")) return;
      raise(target);
      dragging = false;
      if (!canDrag() || e.button !== 0) return;
      startX = e.clientX; startY = e.clientY;
      const rect = target.getBoundingClientRect();
      offsetX = e.clientX - rect.left; offsetY = e.clientY - rect.top;
      handle.setPointerCapture(e.pointerId);
      handle.addEventListener("pointermove", move);
      handle.addEventListener("pointerup", up, { once: true });
    });
    function move(e: PointerEvent) {
      if (!dragging && Math.hypot(e.clientX - startX, e.clientY - startY) > DRAG_THRESHOLD) dragging = true;
      if (!dragging) return;
      const bounds = desktop.getBoundingClientRect();
      target.style.left = `${Math.min(Math.max(e.clientX - offsetX - bounds.left, 0), bounds.width - target.offsetWidth)}px`;
      target.style.top = `${Math.min(Math.max(e.clientY - offsetY - bounds.top, 0), bounds.height - target.offsetHeight)}px`;
    }
    function up() { handle.removeEventListener("pointermove", move); }
    return () => dragging;
  }

  const openWindow = (id: string, from: HTMLElement) => {
    const win = document.getElementById(id);
    if (!win) return;
    if (win.hidden) {
      win.hidden = false;
      // Open new windows just to the right of the icon that launched them.
      const bounds = desktop.getBoundingClientRect(), icon = from.getBoundingClientRect();
      win.style.left = `${Math.max(8, Math.min(icon.right - bounds.left + 24, bounds.width - win.offsetWidth - 8))}px`;
      win.style.top = `${Math.max(8, Math.min(icon.top - bounds.top, bounds.height - win.offsetHeight - 8))}px`;
    }
    raise(win);
    win.querySelector<HTMLElement>("[data-close]")?.focus();
  };

  const icons = [...desktop.querySelectorAll<HTMLElement>(".desk-icon")];
  icons.forEach(icon => {
    const wasDragged = makeDraggable(icon);
    let pointerType = "";
    icon.addEventListener("pointerdown", e => { pointerType = e.pointerType; });
    const open = () => {
      if (icon.dataset.href) location.href = icon.dataset.href;
      else if (icon.dataset.open) openWindow(icon.dataset.open, icon);
    };
    icon.addEventListener("click", e => {
      if (wasDragged()) return;
      icons.forEach(other => other.classList.toggle("selected", other === icon));
      // Mice double-click like the real Finder; touch and keyboard open on a single press.
      if (e.detail === 0 || pointerType === "touch" || !canDrag()) open();
    });
    icon.addEventListener("dblclick", () => { if (!wasDragged()) open(); });
  });
  desktop.addEventListener("pointerdown", e => { if (e.target === desktop) icons.forEach(icon => icon.classList.remove("selected")); });

  desktop.querySelectorAll<HTMLElement>(".window").forEach(win => {
    makeDraggable(win, win.querySelector<HTMLElement>("[data-drag-handle]")!);
    const close = () => {
      win.hidden = true;
      icons.find(icon => icon.dataset.open === win.id)?.focus();
    };
    win.querySelector("[data-close]")?.addEventListener("click", close);
    win.addEventListener("keydown", e => { if (e.key === "Escape") close(); });
  });
</script>
