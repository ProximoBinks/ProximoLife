---
import Layout from "../components/Layout.astro";
import Window from "../components/Window.astro";
---
<Layout title="proximo – say hello" description="Send me a message about a post, a project or anything else. It goes straight to my inbox.">
  <form id="contact-form" class="narrow" method="post" action="/api/contact" data-json-form>
    <h1 class="sr-only">Say hello</h1>
    <Window title="New Message" proxy="/aqua/icons/mail.png" class="opens" bodyClass="flush">
      <div class="toolbar" slot="toolbar">
        <button type="submit" class="toolbar-item"><img src="/aqua/icons/mail.png" alt="" width="32" height="32" /><span>Send Message</span></button>
      </div>
      <div class="mail-fields">
        <span class="label">To</span><span><span class="placard">proximo</span></span>
        <label for="name">Your name</label><input id="name" name="name" type="text" autocomplete="name" maxlength="100" required />
        <label for="email">Email address</label><input id="email" name="email" type="email" autocomplete="email" maxlength="254" required />
      </div>
      <label for="message" class="sr-only">Message</label>
      <textarea id="message" name="message" class="mail-body" placeholder="A thought, a question, or just a wave…" rows="10" maxlength="10000" required></textarea>
      <div class="honeypot" aria-hidden="true"><label for="website">Leave this field empty</label><input id="website" name="website" tabindex="-1" autocomplete="off" /></div>
      <p slot="status" class="status" role="status" aria-live="polite" data-status>Messages go straight to my inbox.</p>
    </Window>
  </form>
</Layout>
<script>import "../scripts/forms";</script>
