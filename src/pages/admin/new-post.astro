---
import Layout from "../../components/Layout.astro";
import Window from "../../components/Window.astro";
import { LogOut } from "@lucide/astro";
import { authenticated } from "../../utils/auth";
if (!authenticated(Astro.cookies, "admin")) return Astro.redirect("/login?returnTo=/admin/new-post", 302);
---
<Layout title="proximo – write an entry" noindex>
  <Window title="New Entry" heading proxy="/aqua/icons/rtf.png" class="opens">
    <div class="toolbar small" slot="toolbar">
      <a class="toolbar-item" href="/blog"><img src="/aqua/icons/documentsfolder.png" alt="" width="16" height="16" /><span>Diary</span></a>
      <i class="spacer"></i>
      <form action="/api/logout" method="post"><button class="with-icon" type="submit"><LogOut size={13} />Sign out</button></form>
    </div>
    <form id="new-post-form" class="form-grid" action="/api/new-post" method="post" data-json-form>
      <label for="title">Title</label><input id="title" name="title" type="text" maxlength="200" required />
      <label for="slug">URL slug</label><div><input id="slug" name="slug" type="text" maxlength="200" pattern="[a-z0-9]+(-[a-z0-9]+)*" aria-describedby="slug-help" required /><small id="slug-help">{Astro.url.host}/blog/<span id="slug-preview">…</span></small></div>
      <label for="author">Author</label><input id="author" name="author" type="text" maxlength="100" autocomplete="name" value="proximo" required />
      <label for="tags">Tags</label><div><input id="tags" name="tags" type="text" placeholder="e.g. coding, life" aria-describedby="tags-help" /><small id="tags-help">Separate with commas. Up to 20 tags, 40 characters each.</small></div>
      <label for="content" class="top">Post content</label><div><textarea id="content" name="content" rows="14" maxlength="100000" aria-describedby="content-help" required></textarea><small id="content-help">Plain text, or HTML for paragraphs, headings, and links.</small></div>
      <span></span><div class="field-row"><input id="private" name="private" type="checkbox" /><label for="private">Private – readers need the diary password</label></div>
      <div class="span buttons-row"><p class="status" role="status" data-status style="flex:1"></p><button type="submit" class="default">Publish Entry</button></div>
    </form>
  </Window>
</Layout>
<script>import "../../scripts/forms";
const title = document.querySelector<HTMLInputElement>("#title");
const slug = document.querySelector<HTMLInputElement>("#slug");
const preview = document.getElementById("slug-preview");
let edited = false;
const showSlug = () => { if (preview) preview.textContent = slug?.value || "…"; };
slug?.addEventListener("input", () => { edited = true; showSlug(); });
const updateSlug = () => { if (slug && title && !edited) slug.value = title.value.toLowerCase().normalize("NFKD").replace(/[̀-ͯ]/g, "").replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, ""); showSlug(); };
title?.addEventListener("input", updateSlug);
if (!slug?.value) updateSlug();
</script>
