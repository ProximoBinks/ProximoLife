---
import Layout from "../../components/Layout.astro";
import Window from "../../components/Window.astro";
import { Heart, Globe, Lock, LogOut } from "@lucide/astro";
import { api, database } from "../../utils/database";
import { authenticated } from "../../utils/auth";
import sanitize from "sanitize-html";
import type { FunctionReturnType } from "convex/server";
let post: FunctionReturnType<typeof api.posts.get> = null;
let unavailable = false;
try { const { client, secret } = database(); post = await client.query(api.posts.get, { secret, slug: Astro.params.slug ?? "" }); }
catch { unavailable = true; }
const reader = authenticated(Astro.cookies, "reader");
const admin = authenticated(Astro.cookies, "admin");
if (unavailable) Astro.response.status = 503;
else if (!post) Astro.response.status = 404;
else if (!post.isPublic && !reader) return Astro.redirect(`/login?returnTo=${encodeURIComponent(Astro.url.pathname)}`, 302);
const date = post && new Date(post.created_at).toLocaleDateString("en-AU", { day: "numeric", month: "long", year: "numeric", timeZone: "Australia/Adelaide" });
// Share text is the post's own opening, cut at a word boundary. Private entries never expose it.
const plain = post?.content.replace(/<[^>]*>/g, " ").replace(/&nbsp;/g, " ").replace(/&amp;/g, "&").replace(/&#39;|&rsquo;/g, "’").replace(/&quot;/g, '"').replace(/\s+/g, " ").trim() ?? "";
const excerpt = plain.length > 158 ? `${plain.slice(0, 158).replace(/\s+\S*$/, "")}…` : plain;
const description = post?.isPublic ? excerpt : "A private entry in proximo’s diary.";
const jsonLd = post?.isPublic ? { "@context": "https://schema.org", "@type": "BlogPosting", headline: post.title, description: excerpt, datePublished: post.created_at, author: { "@type": "Person", name: post.author }, keywords: post.tags.join(", "), inLanguage: "en-AU", mainEntityOfPage: new URL(Astro.url.pathname, Astro.url.origin).href, image: new URL("/og-image.jpg", Astro.url.origin).href } : undefined;
---
<Layout title={post ? `${post.title} – proximo` : "proximo – entry not found"} description={description} noindex={!post?.isPublic} article={post?.isPublic ? { published: post.created_at, tags: post.tags } : undefined} jsonLd={jsonLd}>
  <Window title={post?.title ?? "Digital Diary"} proxy="/aqua/icons/rtf.png" class="opens" bodyClass="paper">
    <div class="toolbar small" slot="toolbar">
      <a class="toolbar-item" href="/blog"><img src="/aqua/icons/documentsfolder.png" alt="" width="16" height="16" /><span>Diary</span></a>
      <i class="spacer"></i>
      {post && <>
        <button type="button" class="with-icon like" id="like-button" data-slug={post.slug} aria-pressed="false"><Heart size={13} /><span data-like-label>Like</span></button>
        {admin && <button type="button" class="with-icon" id="visibility-button" data-slug={post.slug} data-public={String(!!post.isPublic)}>{post.isPublic ? <Lock size={13} /> : <Globe size={13} />}{post.isPublic ? "Make Private" : "Make Public"}</button>}
        {reader && <form action="/api/logout" method="post"><button class="with-icon" type="submit"><LogOut size={13} />Sign out</button></form>}
      </>}
    </div>
    <article class="document">
      {unavailable ? <><h1>This entry couldn’t be loaded.</h1><p>Try loading the page again in a moment.</p></>
        : !post ? <><h1>There’s no entry here.</h1><p>Head back to <a href="/blog">the diary</a> to find a post.</p></>
        : <>
          <h1>{post.title}</h1>
          <p class="meta">By {post.author} · <time datetime={post.created_at}>{date}</time></p>
          {post.tags.length > 0 && <div class="tags">{post.tags.map(tag => <span class="placard">{tag}</span>)}</div>}
          <div class="post-content prose prose-neutral" set:html={sanitize(post.content)}></div>
        </>}
    </article>
    <Fragment slot="status">
      {post ? <>
        <span><span data-views>{post.views}</span> views</span>
        <span><span id="like-count">{post.likes}</span> likes</span>
        <span class="spacer"></span>
        <span class="placard">{post.isPublic ? "Public" : "Private"}</span>
        <span class="status" id="post-status" role="status"></span>
      </> : <a href="/blog">Back to the diary</a>}
    </Fragment>
  </Window>
</Layout>
<script>
  const like = document.querySelector<HTMLButtonElement>("#like-button");
  const status = document.getElementById("post-status");
  const send = async (path: string, body: object) => {
    const response = await fetch(path, { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(body) });
    const result = await response.json();
    if (!response.ok) throw new Error(result.error || "Please try again.");
    return result;
  };
  const report = (error: unknown) => { if (status) { status.dataset.error = "true"; status.textContent = error instanceof Error ? error.message : "Something went wrong."; } };
  if (like) {
    const slug = like.dataset.slug!;
    const markLiked = () => { like.setAttribute("aria-pressed", "true"); like.querySelector("[data-like-label]")!.textContent = "Liked"; };
    try { if (localStorage.getItem(`liked_${slug}`)) markLiked(); } catch {}
    // Counts are already server-rendered; this request never hides or shifts content.
    send("/api/view-post", { slug }).then(result => { const views = document.querySelector("[data-views]"); if (views) views.textContent = String(result.newViews); }).catch(() => {});
    like.addEventListener("click", async () => {
      if (like.getAttribute("aria-pressed") === "true") return;
      like.disabled = true;
      try {
        const result = await send("/api/like-post", { slug });
        document.getElementById("like-count")!.textContent = String(result.newLikes);
        markLiked();
        try { localStorage.setItem(`liked_${slug}`, "true"); } catch {}
      } catch (error) { report(error); }
      finally { like.disabled = false; }
    });
  }
  const visibility = document.querySelector<HTMLButtonElement>("#visibility-button");
  visibility?.addEventListener("click", async () => {
    visibility.disabled = true;
    try {
      await send("/api/post-visibility", { slug: visibility.dataset.slug, isPublic: visibility.dataset.public !== "true" });
      location.reload();
    } catch (error) { report(error); visibility.disabled = false; }
  });
</script>
