---
import PostRow from "./PostRow.astro";
import type { FunctionReturnType } from "convex/server";
import type { api } from "../utils/database";
type Post = FunctionReturnType<typeof api.posts.list>["posts"][number];
interface Props { posts: Post[]; pinned?: Post[]; filterable?: boolean }
const { posts, pinned = [], filterable = false } = Astro.props;
---
<table class="list">
  <thead><tr><th scope="col">Name</th><th scope="col">Date</th><th scope="col" class="col-tags">Tags</th></tr></thead>
  {pinned.length > 0 && (
    <tbody data-group>
      <tr class="group-row"><th scope="colgroup" colspan="3">Pinned</th></tr>
      {pinned.map(post => <PostRow post={post} filterable={filterable} pinned />)}
    </tbody>
  )}
  <tbody data-group>
    {pinned.length > 0 && posts.length > 0 && <tr class="group-row"><th scope="colgroup" colspan="3">All entries</th></tr>}
    {posts.map(post => <PostRow post={post} filterable={filterable} />)}
  </tbody>
</table>
