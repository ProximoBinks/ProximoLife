---
import { Pin } from "@lucide/astro";
import type { FunctionReturnType } from "convex/server";
import type { api } from "../utils/database";
type Post = FunctionReturnType<typeof api.posts.list>["posts"][number];
interface Props { post: Post; filterable?: boolean; pinned?: boolean }
const { post, filterable = false, pinned = false } = Astro.props;
const date = new Date(post.created_at).toLocaleDateString("en-AU", { day: "numeric", month: "short", year: "numeric", timeZone: "Australia/Adelaide" });
---
<tr class:list={{ pinned }} data-tags={filterable ? JSON.stringify(post.tags) : undefined} data-title={filterable ? post.title.toLowerCase() : undefined}>
  <td>
    <div class="name">
      <span class="doc-icon"><img src="/aqua/icons/txt.png" alt="" width="32" height="32" />{!post.isPublic && <img class="badge" src="/aqua/icons/lock.png" alt="" width="11" height="15" />}</span>
      <div>
        <a class="title" href={`/blog/${post.slug}`}>{pinned && <Pin class="pin" size={12} />}{post.title}{pinned && <span class="sr-only"> (pinned)</span>}{!post.isPublic && <span class="sr-only"> (private)</span>}</a>
        {post.isPublic ? <p class="excerpt">{post.excerpt}</p> : <p class="lock">Private – needs the diary password</p>}
      </div>
    </div>
  </td>
  <td class="when"><time datetime={post.created_at}>{date}</time></td>
  <td class="col-tags"><div class="tags">{post.tags.map(tag => <span class="placard">{tag}</span>)}</div></td>
</tr>
